<% if guest_can_answer? %>

  <% if user&.guest? %>
    <div class="callout warning margin-bottom" data-closable>
      <h5><i class="icon-info-circled"></i> You are participating as a guest</h5>
      <p>
        <%= link_to "Register now", new_user_registration_path %> to save your civic history permanently!
      </p>
    </div>
  <% end %>

  <% if voted_in_booth? %>
    <%= callout(t("polls.show.already_voted_in_booth")) %>
  <% elsif voted_in_web? %>
    <% if voted_blank? %>
      <%= callout(t("polls.show.already_voted_blank_in_web")) %>
    <% else %>
      <%= callout(t("polls.show.already_voted_in_web")) %>
    <% end %>
  <% end %>

<% else %>
  <% if user.nil? %>
    <%= callout(not_logged_in_text, html_class: "primary") %>
  <% elsif user.unverified? %>
    <%= callout(unverified_text) %>
  <% elsif poll.expired? %>
    <%= callout(t("polls.show.cant_answer_expired"), html_class: "alert") %>
  <% else %>
    <%= callout(t("polls.show.cant_answer_wrong_geozone")) %>
  <% end %>
<% end %>
